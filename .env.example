# OHO TECH Platform Environment Configuration Template

# Frontend Base API URL (Spring Boot Backend)
NEXT_PUBLIC_API_URL=http://localhost:8080

# PostgreSQL Database Connection
DB_URL=jdbc:postgresql://localhost:5432/OHOTECH
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password_here

# JWT Authentication
JWT_SECRET=your_base64_encoded_jwt_secret_key_minimum_256_bits_length

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# SMTP Email Gateway Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@domain.com
MAIL_PASSWORD=your_app_password
