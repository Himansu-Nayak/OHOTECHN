# ==============================================================================
# OHO TECH — Environment Configuration Template
# ==============================================================================

# Backend Spring Boot API Endpoint (default: http://localhost:8080)
NEXT_PUBLIC_API_URL=http://localhost:8080

# Resend API Key for Quote & Enquiry Email Notifications
RESEND_API_KEY=re_your_resend_api_key_here

# PostgreSQL / Prisma Database Connection URL
DATABASE_URL=postgresql://postgres:password@localhost:5432/ohotech?schema=public

# Razorpay Client Key ID (optional, for checkout payments)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id_here
