# OHO TECH Platform Environment Configuration Template
# DO NOT COMMIT REAL PRODUCTION CREDENTIALS TO GIT.

# Frontend API Endpoint
NEXT_PUBLIC_API_URL=http://localhost:8080

# PostgreSQL Production Database Connection
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/OHOTECH
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_db_password_here

# JWT Security (Minimum 256-bit secure key)
JWT_SECRET=your_secure_jwt_secret_key_minimum_256_bits_length
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# SMTP Production Mail Gateway (Resend / SendGrid / Gmail)
SPRING_MAIL_HOST=smtp.resend.com
SPRING_MAIL_PORT=465
SPRING_MAIL_USERNAME=resend
SPRING_MAIL_PASSWORD=re_your_resend_api_key_here
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_SSL_ENABLE=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=false
SPRING_MAIL_FROM_ADDRESS=onboarding@resend.dev

# Razorpay Payment Gateway (Production / Live Keys)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_live_razorpay_key_secret

# Ad Platform Webhook Integration Secrets
META_APP_SECRET=your_meta_app_secret
GOOGLE_DEVELOPER_TOKEN=your_google_developer_token
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret

# Resend Email API Key (Frontend / Backend API)
RESEND_API_KEY=re_your_resend_api_key_here
