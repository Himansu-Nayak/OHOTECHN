# ==============================================================================
# OHO TECHN Backend — Environment Configuration Template
# ==============================================================================

# Server Port (default: 8080)
PORT=8080

# Spring Profile (dev, prod)
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL Database Connection
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/OHOTECH
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_postgres_password_here

# Security / JWT (HS512 HMAC Secret must be at least 32 characters)
JWT_SECRET=your_jwt_secret_key_must_be_at_least_32_characters_long_for_hs512
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS Allowed Origin (supports comma-separated origins)
FRONTEND_URL=http://localhost:3000

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_live_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_key_here

# SMTP / Email Service (Resend SMTP)
SPRING_MAIL_HOST=smtp.resend.com
SPRING_MAIL_PORT=465
SPRING_MAIL_USERNAME=resend
SPRING_MAIL_PASSWORD=re_your_resend_api_key_here
SPRING_MAIL_FROM_ADDRESS=onboarding@resend.dev

# Cloud Object Storage (LOCAL, S3, R2, MINIO)
STORAGE_PROVIDER=LOCAL
STORAGE_LOCAL_BASE_DIR=./storage
AWS_S3_BUCKET=ohotech-releases
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
