# OHO TECH Backend Production Environment Configuration Template
# DO NOT COMMIT REAL SECRETS TO GIT.

# Server Port
PORT=8080

# Active Spring Profile (set to 'prod' for production enforcement)
SPRING_PROFILES_ACTIVE=prod

# PostgreSQL 17 Database Credentials
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/OHOTECH
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_secure_db_password_here
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Security / JWT (Minimum 32 characters / 256 bits required in production)
JWT_SECRET=your_secure_jwt_secret_key_minimum_256_bits_length
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Initial Admin Bootstrap (First Boot Only - Optional)
INITIAL_ADMIN_EMAIL=admin@ohotech.com
INITIAL_ADMIN_PASSWORD=your_secure_initial_admin_password_here

# SMTP Production Mail Gateway (Resend / Hostinger / Custom SMTP)
SPRING_MAIL_HOST=smtp.resend.com
SPRING_MAIL_PORT=465
SPRING_MAIL_USERNAME=resend
SPRING_MAIL_PASSWORD=re_your_resend_api_key_here
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_SSL_ENABLE=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=false
SPRING_MAIL_FROM_ADDRESS=onboarding@resend.dev
MAIL_FROM_NAME=OHO TECHN Notification

# Payment Gateway (Razorpay Live / Production Keys)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_live_razorpay_key_secret

# Google Gemini AI Platform Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_TIMEOUT=30000
AI_RATE_LIMIT=60

# Frontend URL for CORS Whitelisting
FRONTEND_URL=http://localhost:3000

# Webhook Ad Integration Secrets
META_APP_SECRET=
META_VERIFY_TOKEN=
GOOGLE_WEBHOOK_SECRET=
LINKEDIN_WEBHOOK_SECRET=
